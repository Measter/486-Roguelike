# Usage: MAKE           Build whateve is out of date
#        MAKE -B        Rebuild everything
#        MAKE clean     Delete build outputs

TASMFLAGS = /zi /l /isrc
TPCFLAGS = /Isrc /Uobj /Oobj /$E- /$G+ /$N+ /$Q+ /$R+ /$S+

# First target is the default
all: rltut.exe clrpal.exe scancode.exe

scancode.exe: src\scancode.pas
    tpc $(TPCFLAGS) /E. src\scancode

rltut.exe: src\rltut.pas obj\types.tpu obj\screen.tpu
    tpc $(TPCFLAGS) /E. src\rltut

clrpal.exe: src\clrpal.pas obj\svga.tpu
    tpc $(TPCFLAGS) /E. src\clrpal

obj\screen.tpu: src\screen.pas obj\svga.tpu obj\types.tpu
    tpc $(TPCFLAGS) /Eobj src\screen

# The unit must be rebuilt when either its source or linked OBJ changes.
obj\svga.tpu: src\svga.pas obj\svgainit.obj obj\svgadraw.obj
    tpc $(TPCFLAGS) /Eobj src\svga

obj\types.tpu: src\types.pas obj\consts.tpu
	tpc $(TPCFLAGS) /Eobj src\types

obj\consts.tpu: src\consts.pas
	tpc $(TPCFLAGS) /Eobj src\consts

obj\svgadraw.obj: src\svgadraw.asm src\tseng.inc
    tasm $(TASMFLAGS) src\svgadraw.asm,obj\svgadraw.obj
obj\svgainit.obj: src\svgainit.asm src\tseng.inc
    tasm $(TASMFLAGS) src\svgainit.asm,obj\svgainit.obj

clean:
    del src\*.bak
    del obj\*.obj
    del obj\*.tpu
    del *.lst
    del *.exe

